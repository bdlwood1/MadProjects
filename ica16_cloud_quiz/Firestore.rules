
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{uid}/attempts/{roundId} {

      function isOwner() {
        return request.auth != null
          && request.auth.uid == uid;
      }

      function validAttempt() {
        let d = request.resource.data;

        return d.keys().hasAll([
            'schemaVersion',
            'variant',
            'categoryId',
            'questionCount',
            'correctCount',
            'submittedAt'
          ])
          && d.keys().hasOnly([
            'schemaVersion',
            'variant',
            'categoryId',
            'questionCount',
            'correctCount',
            'submittedAt'
          ])
          && d.schemaVersion is int
          && d.schemaVersion == 1
          && d.variant == 'A'
          && d.categoryId is int
          && d.categoryId == 9
          && d.questionCount is int
          && d.questionCount == 10
          && d.correctCount is int
          && d.correctCount >= 0
          && d.correctCount <= 10
          && d.submittedAt is timestamp
          && d.submittedAt == request.time;
      }

      allow read: if isOwner();
      allow create: if isOwner() && validAttempt();
      allow update, delete: if false;
    }
  }
}
